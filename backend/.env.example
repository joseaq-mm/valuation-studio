# =============================================================================
# Valuation Studio — backend/.env.example
# Copia:  cp backend/.env.example backend/.env
# Nunca subas backend/.env a GitHub (ya está en .gitignore).
# =============================================================================

# --- 1) MongoDB (OBLIGATORIO — el servidor no arranca sin esto) ---------------
# Local portable: mongodb://localhost:27017
# Atlas producción: mongodb+srv://USER:PASS@cluster.mongodb.net/
MONGO_URL=mongodb://localhost:27017
# Tras importar datos de Emergent suele ser test_database; en Atlas puedes usar valuation_studio
DB_NAME=test_database

# --- 2) CORS / URL pública ---------------------------------------------------
# Orígenes del frontend permitidos (coma-separados). En local: http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# URL pública de la app (enlaces en emails de screener/radar + cookies de sesión)
PUBLIC_APP_URL=http://localhost:3000

# --- 3) Google OAuth (login + sync Nivel I / II) ------------------------------
# https://console.cloud.google.com/ → Credenciales → Aplicación web
# Orígenes JS: http://localhost:3000
# Redirect URI: http://localhost:3000/auth/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 4) LLM / IA (tesis, KPIs, chat, moderación, traducciones) ----------------
# El stub backend/emergentintegrations/ usa litellm. Con equilibrado_plus basta:
#   GEMINI_API_KEY + ANTHROPIC_API_KEY
# OPENAI_API_KEY solo si usas preset pro (investigador GPT-5.2).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=                    # alias de Gemini
# Vacío o placeholder evita KeyError; sin clave de proveedor → respuestas mock
EMERGENT_LLM_KEY=
# Preset de modelos: pro | equilibrado | equilibrado_plus | gemini_solo | minimo_coste
# THESIS_MODEL_PRESET=pro

# --- 5) Tavily — búsqueda web en vivo (tesis, KPIs, chat) ---------------------
# Sustituye DuckDuckGo. https://tavily.com → API Keys
# Sin esta clave, las tesis/KPIs corren sin fuentes web (prompts vacíos de search).
TAVILY_API_KEY=

# --- 6) FRED — datos macro Fed (página /macro) — gratis -----------------------
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- 7) Resend — emails de alertas (screener nocturno / radar) — opcional -----
# https://resend.com
# RESEND_API_KEY=
# SENDER_EMAIL=onboarding@resend.dev

# --- 8) Admin (feedback / comunidad) — opcional ------------------------------
# Email Google que tiene privilegios de administrador
# ADMIN_EMAIL=tu@email.com

# --- 9) Exportación completa Mongo vía HTTP — opcional -----------------------
# GET /api/admin/export-database?secret=...
# EXPORT_SECRET=

# --- 10) Cloudflare R2 — PDFs/imagenes KPI, exports, shares (recomendado prod) -
# Dashboard: Cloudflare → R2 → Create bucket → Manage R2 API Tokens (Object Read & Write).
# Con las 4 vars de abajo el backend usa R2; sin ellas → disco local (.local/blobs/).
# STORAGE_BACKEND=r2          # forzar R2 (falla al arrancar si faltan credenciales)
# STORAGE_BACKEND=local       # forzar disco local aunque R2 esté configurado
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=valuation-studio-files
# R2_ENDPOINT=                # opcional; default https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# STORAGE_DIR=                # solo backend local: carpeta alternativa a .local/blobs/

# --- 11) Migración / Emergent (solo scripts, no runtime) — opcional ----------
# REMOTE_MONGO_URL=mongodb+srv://...
# REMOTE_DB_NAME=test_database
# WEBHOOK_CRON_SECRET=
