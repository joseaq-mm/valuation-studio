# =============================================================================
# Valuation Studio — frontend/.env.example
# Copia:  cp frontend/.env.example frontend/.env
# Tras CUALQUIER cambio: reinicia `npm start` (CRA solo lee .env al arrancar).
# =============================================================================

# URL del backend FastAPI (sin /api al final)
REACT_APP_BACKEND_URL=http://localhost:8000

# Mismo valor que GOOGLE_CLIENT_ID del backend (solo el ID público)
REACT_APP_GOOGLE_CLIENT_ID=

# Panel de modelos LLM en /thesis (solo desarrollo)
# REACT_APP_ENABLE_MODEL_PANEL=false

# Health-check endpoints del craco (rara vez necesario)
# ENABLE_HEALTH_CHECK=false
